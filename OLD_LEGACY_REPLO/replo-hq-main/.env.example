# Copy to .env and fill in. Everything here is read by pydantic-settings
# (apps/api/app/core/config.py), which validates at boot — a missing or
# malformed value raises immediately instead of silently using a default.

# --- Environment ---
ENVIRONMENT=development
DEBUG=false

# --- Postgres ---
# DATABASE_URL, when set, overrides every POSTGRES_* value below.
# Railway and docker-compose both inject it.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
POSTGRES_USER=replo
POSTGRES_PASSWORD=
POSTGRES_DB=replo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Auth ---
# REQUIRED. Minimum 32 characters, and known placeholders are rejected.
# Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Credential encryption (BYOK) ---
# Encrypts users' own API keys at rest (AES-256-GCM). Base64-encoded 32 bytes.
# Generate:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
#
# Losing this key makes every stored credential permanently unreadable — users
# would have to paste their keys again. Back it up somewhere other than here.
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_VERSION=1
# Only set during a key rotation: new writes use the current key while existing
# rows still decrypt with this one.
# CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=

# --- LLM ---
# Platform key, used only for the free-tier generations. Users supply their own
# key (BYOK) for everything else.
OPENROUTER_API_KEY=
# Avoid `:free` models here — they are rate-limited and can be withdrawn without
# notice, which surfaces as a failed generation for a real user.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# --- CORS ---
# Comma-separated.
CORS_ORIGINS=http://localhost:3000

# --- Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
