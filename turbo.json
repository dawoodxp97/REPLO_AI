{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "dist/**"]
    },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "lint": {},
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"], "env": ["TEST_DATABASE_URL"] },
    "dev": { "cache": false, "persistent": true },
    "dev:worker": { "cache": false, "persistent": true }
  }
}
