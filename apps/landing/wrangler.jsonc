{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replo-landing",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // No `env.production` block: `wrangler deploy --env production` would create a
  // second Worker (`replo-landing-production`) that nothing routes to. Production
  // is the top-level config, deployed with plain `wrangler deploy`.
  "env": {
    "preview": {
      "name": "replo-landing-preview",
    },
  },
}
