{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replo-landing",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "env": {
    "production": {},
    "preview": {
      "name": "replo-landing-preview",
    },
  },
}
