{
  "name": "@replo/landing",
  "version": "0.0.0",
  "private": true,
  "description": "Replo marketing site: static export (Cloudflare Pages). Imports @replo/ui only.",
  "scripts": {
    "dev": "next dev --port 7100",
    "build": "next build",
    "start": "npx --yes serve@14.2.6 out -l 7100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@replo/ui": "workspace:*",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@replo/config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
