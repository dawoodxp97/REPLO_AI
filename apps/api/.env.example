# Copy to .env (never commit .env). Each process validates these with Zod at boot (src/platform/config.ts).
NODE_ENV=development
PORT=4000
WORKER_HEALTH_PORT=4001
LOG_LEVEL=debug

# Postgres from `pnpm infra:up`
DATABASE_URL=postgres://app:app@localhost:5432/replo

# Better Auth — generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000
PRODUCT_ORIGIN=http://localhost:3001
# AUTH_COOKIE_DOMAIN=.example.com   # production only: share the session cookie across app. and api.

# GitHub App (read-only Contents + Metadata). Optional in dev until P1.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=            # base64-encoded PEM
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# Models and keys. Every job runs on the user's own key (ADR-007): the platform holds no provider keys.
# Envelope-encryption KEK for BYOK keys — generate: openssl rand -base64 32. Lives ONLY in the secret store in prod.
KEY_ENCRYPTION_KEY=
KEY_ENCRYPTION_KEY_VERSION=1

# Limits (defaults shown)
DEFAULT_BYOK_JOB_BUDGET_USD=2
MAX_LITE_PIPELINE_FILES=300
WORKER_CONCURRENCY=1
MAX_REPO_FILES=5000
MAX_REPO_BYTES=50000000
