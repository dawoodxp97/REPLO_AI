{
  "name": "@replo/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify 5 + oRPC + Better Auth modular monolith. Two entrypoints (HTTP, worker) from one package.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.http.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/main.worker.ts",
    "build": "tsdown",
    "start": "node dist/main.http.mjs",
    "start:worker": "node dist/main.worker.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/platform/db/migrate.ts",
    "db:check-drift": "drizzle-kit check"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@orpc/server": "catalog:",
    "@replo/ai": "workspace:*",
    "@replo/contracts": "workspace:*",
    "@replo/repo-analysis": "workspace:*",
    "better-auth": "^1.7.10",
    "drizzle-orm": "catalog:",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "pino": "^10.4.0",
    "tar-stream": "^3.2.2",
    "uuidv7": "^1.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@replo/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "pino-pretty": "^13.2.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
