# Copy to .env.local (never commit). NEXT_PUBLIC_* are exposed to the browser — never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:7200
NEXT_PUBLIC_APP_URL=http://localhost:7101
NEXT_PUBLIC_SENTRY_DSN=
# Server-side calls from Next to the API (SSR of public tutorial pages), e.g. inside Docker network.
API_INTERNAL_URL=http://localhost:7200
