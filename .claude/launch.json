{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@replo/api", "dev"],
      "port": 4000
    },
    {
      "name": "worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@replo/api", "dev:worker"],
      "port": 4001
    },
    {
      "name": "product",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@replo/product", "dev"],
      "port": 3001
    },
    {
      "name": "landing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@replo/landing", "dev"],
      "port": 3000
    },
    {
      "name": "mock-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@replo/api",
        "exec",
        "tsx",
        "../product/e2e/support/serve-mock-api.ts"
      ],
      "port": 4100
    },
    {
      "name": "product-mock",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@replo/product", "exec", "next", "dev", "--port", "3101"],
      "port": 3101,
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:4100",
        "NEXT_PUBLIC_APP_URL": "http://localhost:3101",
        "API_INTERNAL_URL": "http://localhost:4100"
      }
    }
  ]
}
