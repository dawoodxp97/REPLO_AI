{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@replo/api", "dev"],
      "port": 7200
    },
    {
      "name": "worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@replo/api", "dev:worker"],
      "port": 7201
    },
    {
      "name": "product",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@replo/product", "dev"],
      "port": 7101
    },
    {
      "name": "landing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@replo/landing", "dev"],
      "port": 7100
    },
    {
      "name": "mock-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@replo/api",
        "exec",
        "tsx",
        "../product/e2e/support/serve-mock-api.ts"
      ],
      "port": 7210
    },
    {
      "name": "product-mock",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@replo/product", "exec", "next", "dev", "--port", "7110"],
      "port": 7110,
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:7210",
        "NEXT_PUBLIC_APP_URL": "http://localhost:7110",
        "API_INTERNAL_URL": "http://localhost:7210"
      },
      "autoPort": false
    }
  ]
}
